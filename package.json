{
  "name": "forgepilot-ai",
  "version": "0.1.0",
  "description": "Understand. Engineer. Verify. A TrueForge coding assistant for VS Code.",
  "main": "./dist/extension.js",
  "scripts": {
    "compile": "tsc && node scripts/build.cjs",
    "test": "npm run compile && node tests/core.test.cjs",
    "test:live": "node scripts/smoke.cjs",
    "package": "vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links --out submission/ForgePilot-AI.vsix",
    "vscode:prepublish": "npm run compile"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@truefoundry/trueforge-sdk": "0.185.0",
    "diff": "9.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.105.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "displayName": "ForgePilot AI",
  "publisher": "forgepilot-ai",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [
    "onView:forgepilot.sidebar"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "forgepilot.inline",
        "title": "ForgePilot: Inline Edit"
      },
      {
        "command": "forgepilot.agent",
        "title": "ForgePilot: Open Agent"
      },
      {
        "command": "forgepilot.undo",
        "title": "ForgePilot: Undo Applied Changes"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "forgepilot.inline",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "modification"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgepilot",
          "title": "ForgePilot AI",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "forgepilot": [
        {
          "id": "forgepilot.sidebar",
          "name": "ForgePilot AI",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "ForgePilot",
      "properties": {
        "forgepilot.server": {
          "type": "string",
          "default": "http://127.0.0.1:8790",
          "scope": "application",
          "description": "Local TrueForge server origin."
        },
        "forgepilot.model": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Full model ID configured in TrueForge."
        },
        "forgepilot.contextFiles": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "maximum": 12,
          "description": "Maximum automatically selected repository excerpts."
        },
        "forgepilot.runTimeoutSeconds": {
          "type": "integer",
          "default": 600,
          "minimum": 60,
          "maximum": 1800,
          "description": "Maximum agent run duration in seconds. Inline requests are capped at five minutes."
        }
      }
    }
  }
}
